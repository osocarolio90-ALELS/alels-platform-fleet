ALELS_DB_URL=jdbc:postgresql://localhost:5432/alels_db
ALELS_DB_USER=alels
ALELS_DB_PASSWORD=<required-secret>

ALELS_GATEWAY_PORT=5050
ALELS_BACKEND_PORT=8080
ALELS_JWT_SECRET=<required-random-secret-minimum-32-characters>
ALELS_ROOT_INITIAL_PASSWORD=<required-one-time-secret>
ALELS_TCP_SERVER=netty
ALELS_ALLOW_UNKNOWN_DEVICES=false
ALELS_GATEWAY_ADMISSION_REFRESH_SECONDS=60
ALELS_GATEWAY_COMMAND_DB_THREADS=4
ALELS_GATEWAY_COMMAND_DB_QUEUE=10000
ALELS_KAFKA_MAX_BLOCK_MS=0
ALELS_KAFKA_BUFFER_MEMORY_BYTES=67108864
# Development-only escape hatch. Never enable in production.
ALELS_ALLOW_UNSAFE_PUBLISHER_MODE=false
ALELS_GATEWAY_MAX_FRAME_BYTES=1048576
ALELS_GATEWAY_BACKLOG=65535
ALELS_GATEWAY_HEALTH_PORT=9090
ALELS_GATEWAY_HEALTH_HOST=127.0.0.1
ALELS_GATEWAY_MAX_CONNECTIONS=100000
ALELS_GATEWAY_MAX_PENDING_PUBLISHES=100000

# Phase-1 runtime cache foundation
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_MAXMEMORY=512mb
REDIS_PRESENCE_TTL_SECONDS=420

# Phase-1 Kafka scale tuning; tune after benchmark and broker sizing
TELEMETRY_RAW_PARTITIONS=96
TELEMETRY_PARSED_PARTITIONS=96
TELEMETRY_DLQ_PARTITIONS=24
TELEMETRY_RAW_RETENTION_MS=259200000
TELEMETRY_DLQ_RETENTION_MS=2592000000
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
ALELS_KAFKA_SECURITY_PROTOCOL=PLAINTEXT
# Production TLS/SASL values are required from the secret manager, never committed.
# ALELS_KAFKA_SASL_MECHANISM=SCRAM-SHA-512
# ALELS_KAFKA_SASL_JAAS_CONFIG=<required-secret>
# ALELS_KAFKA_SSL_TRUSTSTORE_LOCATION=<required-path>
# ALELS_KAFKA_SSL_TRUSTSTORE_PASSWORD=<required-secret>
KAFKA_CONSUMER_GROUP_ID=alels-ingestion-service
KAFKA_CONSUMER_MAX_POLL_RECORDS=500
KAFKA_CONSUMER_SESSION_TIMEOUT_MS=30000
KAFKA_CONSUMER_MAX_POLL_INTERVAL_MS=300000
DATABASE_POOL_MINIMUM_IDLE=2
ALELS_INGESTION_HEALTH_PORT=9091
ALELS_INGESTION_HEALTH_HOST=127.0.0.1
INGESTION_MAX_RETRIES=3
INGESTION_RETRY_BACKOFF_MS=250
INGESTION_LAG_SNAPSHOT_INTERVAL_MS=30000
